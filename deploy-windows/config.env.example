@echo off
REM ============================================================
REM  PMS Console - Environment Configuration
REM  Copy this file to config.env and edit values for your site
REM ============================================================

REM ---- Database (MSSQL) ----
set DB_SERVER=10.8.8.88
set DB_NAME=MoveonDB
set DB_USER=sa
set DB_PASSWORD=change-me-strong-password
set DB_PORT=1433
REM Leave DB_ENCRYPT unset for in-network IP. Set "true" for TLS hostnames.
REM set DB_ENCRYPT=false

REM ---- Auth / session ----
REM Generate with: openssl rand -base64 48 (or any 48+ char random string)
set JWT_SECRET=replace-with-48-char-random-string
set NEXTAUTH_SECRET=replace-with-48-char-random-string

REM Public URL the app is served at
set NEXTAUTH_URL=http://192.168.88.98:3000

REM ---- Runtime ----
set NODE_ENV=production
set PORT=3000
set HOSTNAME=0.0.0.0
set NEXT_TELEMETRY_DISABLED=1

REM Set to 1 because we serve over plain HTTP (internal network).
REM Allows session cookies to be sent without HTTPS.
set COOKIE_INSECURE=1

REM ---- File Storage ----
REM Network share path for file uploads (UNC path).
REM File-service.ts reads this when present; otherwise uses Settings page config.
REM set FILE_STORAGE_PATH=\\10.8.8.88\ftp\pms
