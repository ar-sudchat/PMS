# =============================================================
# PMS environment variables — copy to .env (local) or set in Coolify
# =============================================================

# ---- Database (MSSQL) ----
# On the VPS, point this at the MSSQL container hostname inside Coolify
# (e.g. "pms-mssql") or the container's exposed IP. Locally you can use
# the in-house server 10.8.8.88.
DB_SERVER=pms-mssql
DB_NAME=MoveonDB
DB_USER=sa
DB_PASSWORD=changeme-strong-password
DB_PORT=1433
# DB_ENCRYPT: leave unset for in-network IPs; set "true" for hostnames behind TLS.
# DB_ENCRYPT=false

# ---- Auth / session ----
# Generate with:  openssl rand -base64 48
JWT_SECRET=replace-with-48-char-random-string
NEXTAUTH_SECRET=replace-with-48-char-random-string

# Public URL the app is served at — match the DuckDNS / domain you configured.
NEXTAUTH_URL=https://pms.duckdns.org

# ---- Runtime hints (optional) ----
# Set to 1 only when running the app over plain HTTP and you still want session
# cookies to be sent. Leave unset in production (HTTPS).
# COOKIE_INSECURE=

# ---- Next.js ----
NEXT_TELEMETRY_DISABLED=1
